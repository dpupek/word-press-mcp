{
  "name": "wordpress-mcp",
  "version": "0.1.4",
  "type": "module",
  "bin": {
    "wordpress-mcp": "./index.js"
  },
  "files": [
    "index.js",
    "src/",
    "spec/",
    "docs/",
    "user-docs/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run generate",
    "capture:routes": "node ./scripts/capture-route-index.js",
    "generate:tools": "node ./scripts/generate-tools.js",
    "generate:help": "node ./scripts/generate-help.js",
    "generate": "npm run generate:tools && npm run generate:help",
    "prepare": "npm run build",
    "smoke:package": "node ./scripts/smoke-package-install.js",
    "smoke:live": "node ./scripts/live-smoke.js",
    "smoke:live:menus": "node ./scripts/live-menu-smoke.js",
    "verify:parity": "node ./scripts/verify-spec-parity.js",
    "pretest": "npm run generate",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0",
    "undici": "^7.16.0",
    "zod": "^3.25.76"
  }
}
